DB_HOST=localhost
DB_PORT=5432
DB_NAME=barberhub
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MAX=25
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

JWT_SECRET=change_this_to_a_long_random_string
SESSION_SECRET=change_this_to_a_different_long_random_string
JWT_EXPIRES_IN=12h
JWT_ISSUER=jotma
JWT_AUDIENCE=jotma-web
NODE_ENV=development
PORT=4000
TRUST_PROXY=false
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated origins.
# Production example:
# CORS_ORIGINS=https://jotma.net,https://www.jotma.net
# Always include both apex and www if both are used.
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:5500,http://localhost:5500

# Request limits
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=12
LOGIN_RATE_LIMIT_MAX=8
SEND_CODE_RATE_LIMIT_MAX=6
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MS=900000
SESSION_MAX_AGE_MS=3600000

# Booking conflict controls
BOOKING_BUFFER_MINUTES=10

# Nodemailer (optional, for email verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=JOTMA <your_email@gmail.com>

# WhatsApp Cloud API (optional, for automatic booking notifications)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_DEFAULT_COUNTRY_CODE=1

# Cloudflare Turnstile (optional, recommended in production)
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# Optional alert webhook (Slack/Discord/custom)
ALERT_WEBHOOK_URL=

# Cloudinary (required for service image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth (optional, for social login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
APP_URL=https://jotma.net
