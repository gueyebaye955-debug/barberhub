DB_HOST=localhost
DB_PORT=5432
DB_NAME=barberhub
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000

JWT_SECRET=change_this_to_a_long_random_string
PORT=4000
TRUST_PROXY=false

# Comma-separated origins. Keep empty for local testing only.
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:5500,http://localhost:5500

# Request limits
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Booking conflict controls
BOOKING_BUFFER_MINUTES=10

# Nodemailer (optional, for email verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=BarberHub <your_email@gmail.com>

# WhatsApp Cloud API (optional, for automatic booking notifications)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v20.0
WHATSAPP_DEFAULT_COUNTRY_CODE=1
